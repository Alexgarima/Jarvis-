{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication and personalization details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserHistory": {
      "title": "UserHistory",
      "description": "Voice command and action history record for JARVIS assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "prompt": { "type": "string", "maxLength": 1000 },
        "spokenResponse": { "type": "string", "maxLength": 2000 },
        "actionType": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "prompt", "spokenResponse", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data accessible only by the user"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "UserHistory",
      "description": "Stores user voice interaction history accessible only by the owner"
    }
  }
}
